      <td class="govuk-table__cell">Built-in admin user</td>
      <td class="govuk-table__cell">SSO via SAML or OIDC, MFA</td>
    </tr>
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header">Custom domain</th>
      <td class="govuk-table__cell">CloudFront URL</td>
      <td class="govuk-table__cell">archive.yourcouncil.gov.uk + ACM certificate</td>
    </tr>
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header">Document ingestion</th>
      <td class="govuk-table__cell">36 sample parish documents</td>
      <td class="govuk-table__cell">IMAP scrape, scanner-direct upload, batch import</td>
    </tr>
    <tr class="govuk-table__row">
      <th scope="row" class="govuk-table__header">Backup & retention</th>
      <td class="govuk-table__cell">Aurora 1-day automated</td>
      <td class="govuk-table__cell">Point-in-time recovery, retention policy aligned with statutory requirements</td>
    </tr>
    <tr class="govuk-table__row">
