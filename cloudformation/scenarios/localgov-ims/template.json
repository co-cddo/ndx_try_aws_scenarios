    Type: AWS::ServiceCatalogAppRegistry::Application
    Properties:
      Description: NDX:Try - LocalGov IMS Income Management System
      Name:
        Fn::Join:
          - ""
          - - NDXTry_LocalGov_IMS_
            - Ref: AWS::AccountId
      Tags:
        Project: ndx-try-aws-scenarios
        Scenario: localgov-ims
    Metadata:
      aws:cdk:path: LocalGovImsStack/AppRegistryApplication
  AppRegistryAssociation:
    Type: AWS::ServiceCatalogAppRegistry::ResourceAssociation
    Properties:
      Application:
        Fn::GetAtt:
          - AppRegistryApplication
          - Id
      Resource:
        Ref: AWS::StackId
      ResourceType: CFN_STACK
