{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MultiIntentDecomposition",
  "description": "Structured output from the multi-intent decomposer Lambda. Bedrock prompt enforces cap=4. Post-validation truncates by confidence if cap exceeded, populating truncated_intents.",
  "type": "object",
  "required": ["intents", "requires_safeguarding_review"],
  "additionalProperties": false,
  "properties": {
    "intents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["intent_name", "slots", "confidence", "verbatim_excerpt"],
        "additionalProperties": false,
        "properties": {
          "intent_name": {
            "type": "string",
            "enum": [
              "BinCollection",
              "MissedCollection",
              "FlyTip",
              "PotholeReport",
              "BrokenPaving",
              "ParkedVehicle",
              "DampMould",
              "AntiSocialBehaviour",
              "Safeguarding",
              "CouncilTax",
              "BenefitsSupport",
              "PlanningEnquiry",
              "GeneralEnquiry",
              "Other"
            ]
          },
          "slots": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "verbatim_excerpt": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "requires_safeguarding_review": { "type": "boolean" },
    "truncated_intents": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Intent names discarded when more than 4 were detected, ordered by descending discarded confidence."
    }
  }
}
